# Copia este archivo como ".env" y ajusta los valores. NO subas ".env" a GitHub.

# Motor de base de datos: sqlite (por defecto) o mysql
DB_ENGINE=sqlite

# SQLite: nombre del archivo. MySQL: nombre de la base de datos.
DB_NAME=ecotech.db

# Solo para MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña
